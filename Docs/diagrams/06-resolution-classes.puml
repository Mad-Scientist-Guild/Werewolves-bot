@startuml 06-resolution-classes
!pragma layout smetana
title Resolution engine (Core/resolution.py, Core/actions.py)

class Resolution {
  state: GameState
  kind: night | dusk | instant | lynch
  moment: str
  rng: Random
  report: Report
  actions: list[SubmittedAction]
  blocked: dict[int, str]
  visits: list[Visit]
  attacks: list[Attack]
  protections: dict[int, list[Protection]]
  redirects: dict[int, int]
  claims: dict
  flags: dict
  messages: dict[int, list[str]]
  deaths: list
  --
  run(): str (the GM report)
  .. intents ..
  inform() / attack() / commit(fn, after_deaths)
  protect() / block() / redirect()
  claim() / claim_winner() / convert()
  turn_prevented() / keep_use() / revive()
  note() / newspaper()
  .. queries ..
  target_of() / apparent_faction() / apparent_role()
  visitors_of() / left_house()
  actions_by() / ability_of() / choice()
}

class Visit {
  visitor, target
  action_id, source, ability
  pack, blocked, reason
}
class Attack {
  target, cause
  killers, killer_role
  attacker_faction
  enters_house, unstoppable, public
  prevented_by, processed
}
class Protection {
  label
  applies(attack): bool
}
class Report {
  title
  sections: dict[str, list[str]]
  add() / render()
}

class "PREPARE_HOOKS" as PH <<registry>>
class "FINAL_HOOKS" as FH <<registry>>
class "CONVERSIONS" as CV <<registry>>

package "Core/actions.py" {
  class "submit()" as Submit
  class "cancel()" as Cancel
  class "find_ability() / moment_for()\nvalidate_params()" as Validate
}

Resolution "1" *-- "*" Visit
Resolution "1" *-- "*" Attack
Resolution "1" *-- "*" Protection
Resolution "1" *-- "1" Report
Resolution ..> PH : runs first
Resolution ..> FH : runs last
Resolution ..> CV : convert(kind)
Submit ..> Validate
Submit ..> Resolution : INSTANT abilities\nresolve immediately

note bottom of Resolution
  Created by transitions (night lock preview on a deep copy,
  morning for real), lynch (dusk, later lynches),
  gm_tools (GM kill/revive) and by
  actions.submit for INSTANT abilities.
end note
@enduml
